    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Booking.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Application\Booking.Application\Booking.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Booking.Infrastructure\Booking.Infrastructure.csproj" />
